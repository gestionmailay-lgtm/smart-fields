# Copy to .env.local and fill in real values (Supabase project settings, Vercel env vars).
# Needed for any environment (local, Claude Code cloud, etc.) running this app from scratch.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (Supabase Project Settings > Database) - used for one-off
# migrations/scripts, not by the app itself at runtime.
DATABASE_URL=

# Google AI (Gemini) API key, used for the AI agronomic explanations.
GOOGLE_AI_API_KEY=

# Priva climate computer OAuth client credentials (Serres/Aranet module).
PRIVA_CLIENT_ID=
PRIVA_CLIENT_SECRET=

# Vercel Cron auth (see supabase_migrations/001_aranet_archive.sql) - any random string,
# also set as a Vercel env var so Vercel Cron sends it as a bearer token automatically.
CRON_SECRET=
